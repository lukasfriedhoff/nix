#!/bin/sh
# Refuse to push history that contains secrets.
#
# This repository is public. Secrets live in the private nix-secrets repo and
# must never reappear here. The guard matters because several local branches
# predate the history purge and still carry secrets/ at their tips — pushing
# one would republish every ciphertext in it.
#
# Escape hatch, if you are certain: git push --no-verify

set -eu

zero='0000000000000000000000000000000000000000'
status=0

while read -r local_ref local_sha _remote_ref remote_sha; do
	# Branch deletion pushes a null local sha; nothing to inspect.
	[ "$local_sha" = "$zero" ] || [ -z "$local_sha" ] && continue

	if [ "$remote_sha" = "$zero" ]; then
		# New branch: everything not already published.
		range="$local_sha --not --remotes=origin"
	else
		range="$remote_sha..$local_sha"
	fi

	# rev-list --objects prints "<sha> <path>" for every object in the range,
	# so one pass covers both the tip trees and all intermediate history.
	# shellcheck disable=SC2086
	# No head(1) inside this pipeline: closing it early makes sort report a
	# broken pipe. Collect everything, then truncate at display time.
	offenders=$(git rev-list --objects $range 2>/dev/null |
		grep -E '^[0-9a-f]+ (secrets/|\.sops\.yaml$)' |
		awk '{print $2}' | sort -u)

	if [ -n "$offenders" ]; then
		count=$(printf '%s\n' "$offenders" | wc -l | tr -d ' ')
		printf >&2 '\npre-push: refusing to push %s — it carries %s secret path(s):\n' \
			"$local_ref" "$count"
		printf '%s\n' "$offenders" | head -5 | sed 's/^/  /' >&2
		[ "$count" -gt 5 ] && printf >&2 '  … and %s more\n' "$((count - 5))"
		printf >&2 '\n'
		printf >&2 'This repo is public. Secrets belong in the private nix-secrets repo.\n'
		printf >&2 'If this branch predates the history purge, rebase it onto develop\n'
		printf >&2 'or delete it rather than pushing.\n\n'
		status=1
	fi
done

exit "$status"

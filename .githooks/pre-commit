#!/usr/bin/env bash
set -euo pipefail

# Block committing unencrypted secrets or raw private keys.

staged_files="$(git diff --cached --name-only --diff-filter=ACM || true)"
[ -z "$staged_files" ] && exit 0

fail() {
  echo "pre-commit: $*" >&2
  exit 1
}

while IFS= read -r file; do
  [ -n "$file" ] || continue
  # Skip deleted files
  if ! [ -e "$file" ]; then
    continue
  fi

  # Any staged file containing a raw OpenSSH private key is blocked.
  if git show :"$file" | grep -q '-----BEGIN OPENSSH PRIVATE KEY-----'; then
    fail "refusing to commit raw private key in $file; encrypt with sops first"
  fi

  # For anything under secrets/ (except markdown docs), require a sops payload.
  if [[ "$file" == secrets/* ]]; then
    case "$file" in
      *.md) ;;
      *)
        if ! git show :"$file" | grep -q '"sops":'; then
          fail "refusing to commit unencrypted secret $file (missing sops payload)"
        fi
      ;;
    esac
  fi
done <<< "$staged_files"

# Verify staged Nix files are formatted via nixfmt-tree.
repo_root="$(git rev-parse --show-toplevel)"
treefmt_config="${repo_root}/.treefmt.toml"
if [[ ! -f "$treefmt_config" ]]; then
  fail "missing ${treefmt_config}; add a treefmt config for Nix formatting"
fi
mapfile -t nix_files < <(git diff --cached --name-only --diff-filter=ACM -- '*.nix' || true)
if (( ${#nix_files[@]} > 0 )); then
  if command -v treefmt >/dev/null 2>&1; then
    treefmt --fail-on-change --config-file "$treefmt_config" "${nix_files[@]}"
  elif command -v nix >/dev/null 2>&1; then
    nix run nixpkgs#nixfmt-tree -- --fail-on-change --config-file "$treefmt_config" "${nix_files[@]}"
  else
    fail "treefmt not available; install nixfmt-tree or nix"
  fi
fi

exit 0

#!/usr/bin/env bash
set -euo pipefail

# Block committing unencrypted secrets or raw private keys.

# Prefer Nix-provided Bash on macOS (default /bin/bash is 3.2 and lacks features like `mapfile`).
if [[ "${BASH_VERSINFO[0]:-0}" -lt 4 ]]; then
  for candidate in \
    /run/current-system/sw/bin/bash \
    "/etc/profiles/per-user/${USER:-}/bin/bash"; do
    if [[ -x "$candidate" ]]; then
      exec "$candidate" "$0" "$@"
    fi
  done
fi

staged_files="$(git diff --cached --name-only --diff-filter=ACM || true)"
[ -z "$staged_files" ] && exit 0

fail() {
  echo "pre-commit: $*" >&2
  exit 1
}

while IFS= read -r file; do
  [ -n "$file" ] || continue
  # Skip deleted files
  if ! [ -e "$file" ]; then
    continue
  fi

  # Any staged file containing a raw OpenSSH private key is blocked.
  if git show :"$file" | grep -q -- '^-----BEGIN OPENSSH PRIVATE KEY-----$'; then
    fail "refusing to commit raw private key in $file; encrypt with sops first"
  fi

  # For anything under secrets/ (except markdown docs), require a sops payload.
  if [[ "$file" == secrets/* ]]; then
    case "$file" in
      *.md) ;;
      *)
        if ! git show :"$file" | grep -Eq '^[[:space:]]*sops:|"sops"[[:space:]]*:|^sops_'; then
          fail "refusing to commit unencrypted secret $file (missing sops payload)"
        fi
      ;;
    esac
  fi
done <<< "$staged_files"

# Verify staged Nix files are formatted via the flake formatter
# (`nix fmt` -> treefmt with nixfmt/statix/deadnix from nix/treefmt.nix).

# Bash 3.x compatibility: avoid `mapfile` (not available on macOS default bash).
nix_files=()
while IFS= read -r file; do
  [[ -n "$file" ]] || continue
  nix_files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.nix' || true)

if (( ${#nix_files[@]} > 0 )); then
  if command -v nix >/dev/null 2>&1; then
    nix fmt -- --ci "${nix_files[@]}" \
      || fail "formatting/lint issues in staged Nix files; run 'nix fmt' and restage"
  else
    fail "nix not available; install nix to run the flake formatter"
  fi

  # Fast syntax guard over the staged Nix files only. A full
  # `nix flake check --no-build` is intentionally NOT run here: it evaluates
  # the whole flake and fetches the private nix-secrets input on every commit.
  # Run it in CI or manually before pushing instead.
  if command -v nix-instantiate >/dev/null 2>&1; then
    echo "pre-commit: parsing staged .nix files..."
    for file in "${nix_files[@]}"; do
      nix-instantiate --parse "$file" >/dev/null \
        || fail "Nix syntax error in ${file}"
    done
  fi
fi

exit 0

#!/usr/bin/env bash
set -euo pipefail

# Block committing unencrypted secrets or raw private keys.

# Prefer Nix-provided Bash on macOS (default /bin/bash is 3.2 and lacks features like `mapfile`).
if [[ "${BASH_VERSINFO[0]:-0}" -lt 4 ]]; then
  for candidate in \
    /run/current-system/sw/bin/bash \
    "/etc/profiles/per-user/${USER:-}/bin/bash"; do
    if [[ -x "$candidate" ]]; then
      exec "$candidate" "$0" "$@"
    fi
  done
fi

staged_files="$(git diff --cached --name-only --diff-filter=ACM || true)"
[ -z "$staged_files" ] && exit 0

fail() {
  echo "pre-commit: $*" >&2
  exit 1
}

while IFS= read -r file; do
  [ -n "$file" ] || continue
  # Skip deleted files
  if ! [ -e "$file" ]; then
    continue
  fi

  # Any staged file containing a raw OpenSSH private key is blocked.
  if git show :"$file" | grep -q -- '^-----BEGIN OPENSSH PRIVATE KEY-----$'; then
    fail "refusing to commit raw private key in $file; encrypt with sops first"
  fi

  # For anything under secrets/ (except markdown docs), require a sops payload.
  if [[ "$file" == secrets/* ]]; then
    case "$file" in
      *.md) ;;
      *)
        if ! git show :"$file" | grep -q '"sops":'; then
          fail "refusing to commit unencrypted secret $file (missing sops payload)"
        fi
      ;;
    esac
  fi
done <<< "$staged_files"

# Verify staged Nix files are formatted via nixfmt-tree.
repo_root="$(git rev-parse --show-toplevel)"
treefmt_config="${repo_root}/.treefmt.toml"
if [[ ! -f "$treefmt_config" ]]; then
  fail "missing ${treefmt_config}; add a treefmt config for Nix formatting"
fi

# Bash 3.x compatibility: avoid `mapfile` (not available on macOS default bash).
nix_files=()
while IFS= read -r file; do
  [[ -n "$file" ]] || continue
  nix_files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.nix' || true)

if (( ${#nix_files[@]} > 0 )); then
  if command -v treefmt >/dev/null 2>&1; then
    treefmt --fail-on-change --config-file "$treefmt_config" "${nix_files[@]}"
  elif command -v nix >/dev/null 2>&1; then
    nix run nixpkgs#nixfmt-tree -- --fail-on-change --config-file "$treefmt_config" "${nix_files[@]}"
  else
    fail "treefmt not available; install nixfmt-tree or nix"
  fi
fi

# Quick flake syntax check (only if flake.nix is staged or Nix files changed).
if git diff --cached --name-only | grep -qE '(flake\.nix|\.nix$)'; then
  echo "pre-commit: checking flake syntax..."
  if command -v nix >/dev/null 2>&1; then
    # Use --no-write-lock-file to avoid modifying flake.lock during commit
    if ! nix flake check --no-build --no-write-lock-file "$repo_root" 2>/dev/null; then
      # If quick check fails, show the actual error
      nix flake check --no-build --no-write-lock-file "$repo_root" || \
        fail "flake check failed; fix evaluation errors before committing"
    fi
  fi
fi

exit 0
